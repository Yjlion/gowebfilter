[Unit]
Description=WebFilter Proxy - MITM filtering proxy engine only
Documentation=https://github.com/Yjlion/mitmproxy-web-filter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webfilter
Group=webfilter
WorkingDirectory=/opt/webfilter
ExecStart=/opt/webfilter/webfilter proxy --settings config/settings.json
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/webfilter
# In split mode this is the unit that supervises tun2socks, so this is the one
# packaging/install.sh grants CAP_NET_ADMIN/CAP_NET_RAW to (via
# packaging/tun2socks.conf in webfilter-proxy.service.d/) when it is enabled.

[Install]
WantedBy=multi-user.target
