#!/bin/sh
# postinst - runs after dpkg unpacks the package's files. Mirrors
# packaging/install.sh's setup steps (system user, seeded config, ownership,
# enabling the unit) since dpkg itself only lays files down; nothing else
# creates the webfilter user or fixes /opt/webfilter's ownership for a
# plain `dpkg -i`/`apt install ./webfilter_*.deb` install.
set -e

PREFIX=/opt/webfilter

case "$1" in
  configure)
    if ! id -u webfilter >/dev/null 2>&1; then
      useradd --system --home-dir "$PREFIX" --shell /usr/sbin/nologin webfilter
    fi

    # bin/ is where `webfilter tun2socks download` puts the tun2socks binary.
    mkdir -p "$PREFIX/certs" "$PREFIX/logs" "$PREFIX/data" "$PREFIX/bin"

    if [ ! -f "$PREFIX/config/settings.json" ] && [ -f "$PREFIX/config/settings.example.json" ]; then
      cp "$PREFIX/config/settings.example.json" "$PREFIX/config/settings.json"
    fi
    if [ ! -f "$PREFIX/policies/default.json" ] && [ -f "$PREFIX/policies/default.json.example" ]; then
      cp "$PREFIX/policies/default.json.example" "$PREFIX/policies/default.json"
    fi

    chown -R webfilter:webfilter "$PREFIX"

    # TUN capture needs CAP_NET_ADMIN/CAP_NET_RAW, which the shipped unit
    # deliberately does not grant (capture is off by default). Activate the
    # staged drop-in only when this install's settings actually enable it, and
    # let the app parse its own config rather than grepping JSON here.
    DROPIN=/etc/systemd/system/webfilter.service.d/10-tun2socks.conf
    if "$PREFIX/webfilter" tun2socks status --settings "$PREFIX/config/settings.json" 2>/dev/null \
        | grep -qE '^enabled: *true'; then
      if [ -f "$PREFIX/systemd/tun2socks.conf" ]; then
        install -D -m 0644 "$PREFIX/systemd/tun2socks.conf" "$DROPIN"
        echo "webfilter: tun2socks enabled - granted webfilter.service CAP_NET_ADMIN/CAP_NET_RAW"
        # The drop-in also carries the ExecStopPost teardown hook, so the unit
        # has to be reloaded for it to take effect; daemon-reload below covers
        # a fresh install, but an upgrade that only now enables capture needs
        # the running unit restarted to pick up both.
      fi
    elif [ -f "$DROPIN" ]; then
      # Add-only: an operator may have customized it, so report rather than
      # silently removing a privilege grant on upgrade.
      echo "webfilter: tun2socks is disabled but $DROPIN still exists; remove it with: rm $DROPIN"
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      systemctl enable webfilter.service || true
    fi

    echo ""
    echo "webfilter installed to $PREFIX."
    echo "  1. Review/edit $PREFIX/config/settings.json"
    echo "  2. Start:  systemctl start webfilter.service"
    echo "  3. Web UI: http://<host>:8000 (default mgmt_port)"
    echo "  4. Trust the generated CA cert once it's run once: $PREFIX/certs/ca.crt"
    ;;
esac

exit 0
